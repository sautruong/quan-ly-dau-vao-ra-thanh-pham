<IfModule php_module>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1024M
    php_value max_execution_time 600
    php_value max_input_time 600
    php_value memory_limit 512M
</IfModule>

# =====================================================================
#  URL GỌN: /{mod}/{action}[/{id}]  ->  index.php (xem libraries/nav.php)
#  Bỏ qua file/thư mục có thật (public/, uploads/, ảnh, css, js...) để
#  tài nguyên tĩnh vẫn phục vụ trực tiếp, không đi qua PHP.
# =====================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

# PWA: kiểu MIME cho web app manifest (một số Apache chưa khai báo sẵn .webmanifest)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>
# Service worker: không cache file sw.js để cập nhật SW kịp thời
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </Files>
</IfModule>
